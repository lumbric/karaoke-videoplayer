{
  "name": "karaoke-videoplayer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/sync-data-links.sh && vite",
    "build": "rm -rf public/data && vue-tsc -b && vite build && bash scripts/sync-data-links.sh",
    "preview": "vite preview",
    "link:data": "bash scripts/sync-data-links.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run src/components",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.0.15",
    "@types/jsdom": "^21.1.7",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.18",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
