{
  "theme": {
    "name": "default",
    "title": "Karaoke Song Player"
  },
  "features": {
    "onlineFeatures": false,
    "onlineSearch": false,
    "aiSuggestions": false
  },
  "search": {
    "batchSize": 30,
    "maxDisplayCount": 240,
    "initialOrder": "random",
    "randomSeed": 42,
    "showMetadataSnippet": true
  },
  "providers": {
    "searchProviders": [
      { "type": "invidious", "baseUrls": [] }
    ],
    "videoProviders": [
      { "type": "youtube" }
    ]
  },
  "ai": {
    "model": "gpt-4o-mini",
    "maxSuggestions": 5,
    "timeoutMs": 8000,
    "sendCatalog": true
  }
}
