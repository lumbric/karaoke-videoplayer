{
  "theme": {
    "name": "karaoke-ab-hof2025",
    "title": "Karaoke ab Hof"
  },
  "features": {
    "onlineFeatures": true,
    "onlineSearch": true,
    "aiSuggestions": true
  },
  "search": {
    "batchSize": 30,
    "maxDisplayCount": 240,
    "initialOrder": "random",
    "randomSeed": 42,
    "showMetadataSnippet": false
  },
  "providers": {
    "searchProviders": [
      { "type": "youtube" }
    ],
    "videoProviders": [
      { "type": "youtube" }
    ]
  },
  "ai": {
    "model": "gpt-4o",
    "maxSuggestions": 5,
    "timeoutMs": 20000,
    "sendCatalog": false
  },
  "paths": {
    "songsJson": "data/songs.json",
    "videosBase": "videos",
    "coversBase": "covers"
  }
}
