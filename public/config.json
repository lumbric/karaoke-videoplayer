    "batchSize": 30,
    "maxDisplayCount": 500,
    "initialOrder": "random",
    "randomSeed": 42,
    "showMetadataSnippet": false,
    "featuredProbability": 0.3,
    "featuredWindow": 8
  },
  "providers": {
    "searchProviders": [
      { "type": "youtube" }
    ],
    "videoProviders": [
      { "type": "youtube" }
    ]
  },
  "ai": {
    "model": "gpt-4o",
    "maxSuggestions": 5,
    "timeoutMs": 20000,
    "sendCatalog": false
  }
}
