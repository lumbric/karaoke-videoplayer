{
  "app": {
    "title": "Karaoke Song Player"
  },
  "theme": {
    "name": "default",
    "cssPath": "/themes/default.css",
    "logoPath": "/poster2026.jpg",
    "coverFallbackPath": "/themes/default-cover-fallback.svg"
  },
  "features": {
    "onlineSearch": true,
    "aiSuggestions": false
  },
  "search": {
    "batchSize": 30,
    "maxDisplayCount": 240,
    "initialOrder": "random",
    "randomSeed": 42,
    "showMetadataSnippet": true
  },
  "providers": {
    "invidious": {
      "baseUrls": [
        "https://inv.nadeko.net",
        "https://invidious.nerdvpn.de",
        "https://yt.chocolatemoo53.com",
        "https://invidious.tiekoetter.com",
        "https://invidious.f5.si",
        "https://iv.nboeck.de"
      ]
    }
  },
  "ai": {
    "model": "gpt-4o-mini",
    "maxSuggestions": 5,
    "timeoutMs": 8000
  },
  "paths": {
    "songsJson": "/data/songs.json",
    "videosBase": "/songs",
    "coversBase": "/covers"
  }
}
