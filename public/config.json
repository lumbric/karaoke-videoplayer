{
  "theme": {
    "name": "karaoke-ab-hof2026",
    "title": "Karaoke ab Hof"
  },
  "features": {
    "onlineFeatures": true,
    "onlineSearch": true,
    "aiSuggestions": true,
    "filterEmbeddableVideos": true
  },
